# =============================================================================
# .env.example — Metalurgica del Caribe
# Fuente de verdad: docs/contracts/env.md (v2 pendiente de bump por architect)
#
# Reglas:
# - Este archivo documenta NOMBRES y proposito. No contiene valores reales.
# - Copiar a .env.local para desarrollo. Nunca commitear .env ni .env.local.
# - En Vercel, estas variables se definen en la UI (Project Settings -> Environment Variables)
#   y se separan por entorno (Development / Preview / Production).
# - Marcadas como [SECRETO] no se exponen al frontend ni a los logs.
# - Marcadas como [PUBLICO] son accesibles por el cliente (compiladas en build).
#
# Deltas sincronizados round 2 (2026-10-02):
#   - MAIL_PROVIDER default documentado = resend (AU-C-03)
#   - UA_HASH_SALT nueva, [SECRETO] obligatoria (AU-C-01)
#   - UPSTASH_REDIS_REST_URL / _TOKEN opcionales con modo degradado (AU-H-03)
#   - ARCO_EMAIL opcional, destino politica publica (AU-H-05)
# =============================================================================


# -----------------------------------------------------------------------------
# BACKEND (Vercel Functions, runtime nodejs20.x, montado en /api/*)
# -----------------------------------------------------------------------------

# Entorno de ejecucion: development | preview | production
NODE_ENV=

# Puerto HTTP local (solo relevante para `vercel dev`; en prod Vercel asigna)
PORT=

# Nivel de log Pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=

# Dominios permitidos para CORS en /api/*, separados por coma.
# Debe incluir el dominio productivo y, si se desea, el preview *.vercel.app.
# [PUBLICO]
CORS_ORIGIN=

# Rate-limit: maximo de peticiones por ventana por IP.
# NOTA: Vercel Functions son stateless; usar Upstash Redis para rate-limit real.
# Si no se configura Upstash, estas variables quedan como referencia logica
# (modo degradado documentado: honeypot + Zod + consentimiento cubren bots basicos).
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW=

# Upstash Redis (OPCIONAL, recomendado para rate-limit real en serverless).
# Si ambas estan vacias, el backend arranca en modo degradado: no persiste contadores
# entre invocaciones (ver devops/PLAN.md R2 y backend rateLimit.ts). Si ambas
# estan presentes, el backend usa @upstash/ratelimit contra Upstash REST.
# [SECRETO]
UPSTASH_REDIS_REST_URL=
# [SECRETO]
UPSTASH_REDIS_REST_TOKEN=


# -----------------------------------------------------------------------------
# DATABASE (Google Sheets por defecto; Excel como alterno)
# -----------------------------------------------------------------------------

# Driver de persistencia: sheets | excel
DB_DRIVER=

# ID del Google Sheet destino (de la URL del Sheet).
SHEET_ID=

# Nombre de la pestaña dentro del Sheet.
SHEET_TAB=

# Credencial del Service Account en formato JSON serializado en una sola linea.
# Scope requerido: https://www.googleapis.com/auth/spreadsheets
# [SECRETO]
GOOGLE_SA_JSON=

# Ruta al archivo xlsx si DB_DRIVER=excel. Solo para desarrollo local.
EXCEL_PATH=


# -----------------------------------------------------------------------------
# MAIL (Resend por defecto; SMTP como fallback documentado)
# -----------------------------------------------------------------------------

# Proveedor de correo: resend | smtp
# Default confirmado round 2: resend
MAIL_PROVIDER=resend

# API key de Resend. Obtener en https://resend.com/api-keys
# [SECRETO]
RESEND_API_KEY=

# SMTP (fallback). Solo si MAIL_PROVIDER=smtp.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
# [SECRETO]
SMTP_USER=
# [SECRETO]
SMTP_PASS=

# Destinatario del aviso de nueva cotizacion (dueno del negocio).
OWNER_EMAIL=

# Remitente visible en el correo. Debe pertenecer a un dominio verificado en Resend.
FROM_EMAIL=


# -----------------------------------------------------------------------------
# SEGURIDAD / PRIVACIDAD
# -----------------------------------------------------------------------------

# Sal para hash SHA-256 de la IP (anti-abuso sin almacenar IP cruda).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# [SECRETO] OBLIGATORIA
IP_HASH_SALT=

# Sal para hash SHA-256 del User-Agent (minimizacion Ley 1581 art. 4 lit. e).
# El backend persiste user_agent_hash en lugar de UA en claro. Si se rota,
# los hashes historicos quedan huerfanos (impacto: pierde correlacion anti-abuso,
# no pierde datos de negocio). Generar como IP_HASH_SALT.
# [SECRETO] OBLIGATORIA
UA_HASH_SALT=

# Version del aviso de privacidad vigente. Formato YYYY-MM-DD.
# Debe coincidir con la version publicada en /politica-privacidad.html.
CONSENT_VERSION=

# Email publico para ejercicio de derechos ARCO (Habeas Data).
# Sugerencia: datos@<dominio final>. Se publica en la politica de tratamiento.
# OPCIONAL en runtime (no requerida por backend); gobernance la usa en legales.
ARCO_EMAIL=


# -----------------------------------------------------------------------------
# MAPS (frontend, publico pero restringido por HTTP referrer)
# -----------------------------------------------------------------------------

# Google Maps JavaScript API / Embed API key.
# Restriccion obligatoria por HTTP referrer al dominio productivo.
# Ver devops/maps/README.md para pasos de creacion y restriccion.
# [PUBLICO - restringido por referrer]
MAPS_API_KEY=


# -----------------------------------------------------------------------------
# FRONTEND (compilados en build, se inyectan al HTML/JS)
# -----------------------------------------------------------------------------

# URL base del backend (donde el formulario envia POST /api/quotes).
# En Vercel, mismo dominio: dejar vacio o apuntar al dominio final.
# [PUBLICO]
API_BASE_URL=

# URL canonica del sitio (para OG, canonical tag, sitemap, JSON-LD).
# [PUBLICO]
SITE_URL=
