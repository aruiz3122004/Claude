# Puerta Samaria — variables de entorno (todas OPCIONALES)
#
# El sitio no requiere secretos ni claves: no envía correo y guarda las reservas
# localmente con SQLite (node:sqlite). En Render, PORT lo inyecta la plataforma.

# Puerto HTTP en local (en Render lo asigna la plataforma automáticamente).
PORT=3000

# Carpeta de la base de datos SQLite (por defecto ./data).
# En Render con disco persistente, apuntar al punto de montaje:
# DATA_DIR=/var/data

# Entorno de ejecución (informativo).
NODE_ENV=development
